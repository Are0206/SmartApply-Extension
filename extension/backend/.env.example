# Servidor
PORT=3000

# Seguridad
API_SECRET_KEY=change_this_to_a_secure_random_string

# Make.com Integration
# URL del webhook personalizado de Make.com (obtener desde Make.com > Webhooks > Custom Webhook)
MAKE_WEBHOOK_URL=https://hook.make.com/your-webhook-id

# Habilitar envío de eventos a Make.com (true/false)
MAKE_WEBHOOK_ENABLED=true
